{
  "schema": 1,
  "title": "합성 예시: 결제 환불 (열린 결정·삭제·접힘)",
  "context": "클래스 견본(class.map.json)에 없는 표현(점선, [D1], 🗑, 접힌 그룹, 들어 올린 관계)을 시험하는 가상의 설계",
  "direction": "LR",
  "elements": [
    { "id": "Api", "kind": "group" },
    { "id": "OrderController", "parent": "Api" },

    { "id": "Domain", "kind": "group" },
    { "id": "OrderService", "parent": "Domain", "change": "modify", "steps": [1],
      "members": [{ "text": "refund(orderId)", "change": "add" }] },
    { "id": "Payment", "kind": "group", "parent": "Domain", "label": "결제" },
    { "id": "PaymentService", "parent": "Payment", "change": "modify", "steps": [2], "decision": "D1",
      "members": [
        { "text": "pay(order)", "change": "modify", "done": true },
        { "text": "legacyPay()", "change": "delete" }
      ] },
    { "id": "RefundPolicy", "parent": "Payment", "label": "환불 정책", "change": "add", "steps": [3], "decision": "D1",
      "members": [{ "text": "canRefund(order)", "change": "add" }] },
    { "id": "LegacyPayGateway", "parent": "Payment", "change": "delete" },

    { "id": "Infra", "kind": "group" },
    { "id": "OrderRepository", "parent": "Infra" },
    { "id": "PaymentClient", "parent": "Infra", "kind": "interface", "change": "result" },

    { "id": "PG", "kind": "external", "label": "외부 PG사" }
  ],
  "relations": [
    { "from": "OrderController", "to": "OrderService" },
    { "from": "OrderService", "to": "PaymentService", "label": "결제 요청" },
    { "from": "OrderService", "to": "RefundPolicy", "kind": "dependency", "label": "환불 판단", "decision": "D1" },
    { "from": "OrderService", "to": "OrderRepository" },
    { "from": "PaymentService", "to": "PaymentClient" },
    { "from": "RefundPolicy", "to": "PaymentClient", "label": "취소" },
    { "from": "LegacyPayGateway", "to": "PaymentClient", "kind": "realization" },
    { "from": "PaymentClient", "to": "PG" },
    { "from": "OrderController", "to": "Payment", "kind": "dependency", "label": "모듈 의존" }
  ],
  "decisions": [
    { "id": "D1", "question": "환불 가능 여부를 누가 판단하나?",
      "options": [
        { "id": "D1-a", "text": "RefundPolicy를 새로 만든다", "impact": "PaymentService는 pay만 고친다" },
        { "id": "D1-b", "text": "PaymentService 안에서 판단한다", "impact": "RefundPolicy가 사라진다" }
      ] }
  ]
}
